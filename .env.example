# Du trenger ikke redigere denne fila for hånd.
# Start appen (npm start), åpne http://localhost:3000, og lim inn nøklene der —
# de testes med en gang og lagres til .env automatisk.
# Denne fila står igjen som referanse på hva som kan settes.

# ── Supabase (LEADS-prosjektet, krawpaxz) ─────────────────────────────
SUPABASE_URL=https://krawpaxzwygnvoueykcc.supabase.co
# Hent service_role-nøkkelen her: Supabase → Project Settings → API → "service_role" (secret).
# NB: service_role har full tilgang. Den skal KUN ligge her lokalt / på server — aldri i frontend eller GitHub.
SUPABASE_SERVICE_KEY=DIN_SERVICE_ROLE_NOKKEL

# ── Claude (Anthropic) ────────────────────────────────────────────────
# Brukes av: Founders-svar, daglig oppsummering, vurdering og forslag av bedriftsideer.
# Uten denne fungerer resten av dashbordet som normalt — de sidene sier bare fra at nøkkelen mangler.
ANTHROPIC_API_KEY=DIN_ANTHROPIC_NOKKEL

# ── OpenAI (kun embeddings) ───────────────────────────────────────────
# Trengs for å søke i podcast-chunkene. MÅ være OpenAI: de 11 000 bitene i
# podcast_chunks er lagret med text-embedding-3-small (1536 dimensjoner).
# Bytter du modell, matcher ikke vektorene og søket blir ubrukelig.
OPENAI_API_KEY=DIN_OPENAI_NOKKEL

# ── Google Places (legacy API) ────────────────────────────────────────
# Kun for «Hent flere leads» i Leads-CRM-en.
# Krever aktiv billing på Google Cloud-prosjektet.
GOOGLE_PLACES_API_KEY=DIN_GOOGLE_PLACES_NOKKEL

# ── Valgfritt ─────────────────────────────────────────────────────────
# Dashbordet kjører på 3000 som standard.
PORT=3000
# Apps Script-lenka arket ligger bak (brukes bare av importer.js).
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwWQn_iHX-6h716fdhdFWC5dilH_enNWbB_6XnHyWFcwaSX_BJOZ570TJvh2GbM4AVomA/exec
